<div class="fast-nri-sheet fast-nri-item" autocomplete="off">
  <header class="fast-nri-header">
    <img class="fast-nri-portrait" src="{{item.img}}" alt="{{item.name}}" />

    <div class="fast-nri-identity">
      <input class="fast-nri-name" type="text" name="name" value="{{item.name}}" />
      <div class="fast-nri-subline">
        <span>{{item.type}}</span>
        {{#unless isEffect}}
          <label>
            Уровень
            <input type="number" name="system.level" value="{{system.level}}" />
          </label>
        {{/unless}}
      </div>
    </div>
  </header>

  {{#if isWeapon}}
    <section class="fast-nri-section">
      <h2>Оружие</h2>
      <div class="fast-nri-two">
        <label>
          Дистанция
          <input type="text" name="system.range" value="{{system.range}}" />
        </label>
        <label>
          Вид атаки 6.3
          <select name="system.attackType">
            <option value="melee" {{#if (eq system.attackType "melee")}}selected{{/if}}>Ближняя атака</option>
            <option value="ranged" {{#if (eq system.attackType "ranged")}}selected{{/if}}>Дистанционная атака</option>
          </select>
        </label>
        <label>
          Тип урона
          <select name="system.damageType">
            <option value="physical" {{#if (eq system.damageType "physical")}}selected{{/if}}>Физический</option>
            <option value="magic" {{#if (eq system.damageType "magic")}}selected{{/if}}>Магический</option>
          </select>
        </label>
      </div>


      <div class="fast-nri-two">
        <label class="fast-nri-property-field">
          Свойства
          <multi-select name="system.propertyIds">
            {{selectOptions propertyChoices selected=system.propertyIds}}
          </multi-select>
        </label>
        <div class="fast-nri-item-equip-config">
          <label class="fast-nri-checkbox-label" title="Активен и учитывается в системных расчётах">
            <input
              type="checkbox"
              data-fast-nri-item-equipped
              {{#if system.equipped}}checked{{/if}}
            />
            Экипирован
          </label>

          {{#if showHeldToggle}}
            <label class="fast-nri-checkbox-label" title="Физически находится в руках">
              <input
                type="checkbox"
                data-fast-nri-item-held
                {{#if system.held}}checked{{/if}}
              />
              В руках
            </label>
          {{/if}}

          <label>
            Требует рук
            <select data-fast-nri-item-hands>
              <option value="0" {{#if (eq system.hands 0)}}selected{{/if}}>Не требует</option>
              <option value="1" {{#if (eq system.hands 1)}}selected{{/if}}>1</option>
              <option value="2" {{#if (eq system.hands 2)}}selected{{/if}}>2</option>
            </select>
          </label>
        </div>
      </div>

      <div class="fast-nri-three">
        <label>Частичный — базовая формула
          <input type="text" name="system.damage.partial" value="{{system.damage.partial}}" />
        </label>
        <label>Успех — базовая формула
          <input type="text" name="system.damage.success" value="{{system.damage.success}}" />
        </label>
        <label>Большой — базовая формула
          <input type="text" name="system.damage.great" value="{{system.damage.great}}" />
        </label>
      </div>

      <div class="fast-nri-damage-composition">
        <div class="fast-nri-damage-composition-heading">
          <h3>Состав урона</h3>
          <small>Если профиль содержит компоненты ниже, они заменяют его базовую формулу.</small>
        </div>

        {{#each damageComponentProfiles as |profile|}}
          <section class="fast-nri-damage-component-profile">
            <div class="fast-nri-damage-component-profile-heading">
              <strong>{{profile.label}}</strong>
              <button
                type="button"
                data-action="addDamageComponent"
                data-profile="{{profile.id}}"
                title="Добавить компонент урона"
              >
                <i class="fa-solid fa-plus"></i>
                Компонент
              </button>
            </div>

            {{#if profile.components.length}}
              <div class="fast-nri-damage-component-list">
                {{#each profile.components as |component|}}
                  <div class="fast-nri-damage-component-row">
                    <input
                      type="text"
                      value="{{component.formula}}"
                      data-fast-nri-damage-component-field="formula"
                      data-profile="{{profile.id}}"
                      data-index="{{component.index}}"
                      title="Формула компонента"
                    />

                    <select
                      data-fast-nri-damage-component-field="damageType"
                      data-profile="{{profile.id}}"
                      data-index="{{component.index}}"
                      title="Тип урона компонента"
                    >
                      <option value="physical" {{#if (eq component.damageType "physical")}}selected{{/if}}>Физический</option>
                      <option value="magic" {{#if (eq component.damageType "magic")}}selected{{/if}}>Магический</option>
                    </select>

                    <multi-select
                      data-fast-nri-damage-component-field="traitIds"
                      data-profile="{{profile.id}}"
                      data-index="{{component.index}}"
                      title="Свойства этого компонента"
                    >
                      {{selectOptions @root.damageTraitChoices selected=component.traitIds}}
                    </multi-select>

                    <button
                      type="button"
                      class="fast-nri-damage-component-remove"
                      data-action="removeDamageComponent"
                      data-profile="{{profile.id}}"
                      data-index="{{component.index}}"
                      title="Удалить компонент"
                    >
                      <i class="fa-solid fa-trash"></i>
                    </button>
                  </div>
                {{/each}}
              </div>
            {{else}}
              <small class="fast-nri-help">Используется базовая формула профиля и общий тип урона оружия.</small>
            {{/if}}
          </section>
        {{/each}}
      </div>
    </section>
  {{/if}}

  {{#if isAbility}}
    <section class="fast-nri-section fast-nri-ability-editor fast-nri-implementation-editor">
      <div class="fast-nri-section-heading">
        <div>
          <h2>{{#if abilityIsSpell}}Заклинание{{else}}Способность{{/if}}</h2>
          <small class="fast-nri-help">Ability — контейнер. Исполняемая механика хранится в отдельных реализациях; каждая реализация имеет фиксированную цену.</small>
        </div>
      </div>

      <div class="fast-nri-form-grid two-columns">
        <label>Уровень <input type="number" min="0" name="system.level" value="{{system.level}}" /></label>
      </div>
      <label>Общее описание способности
        <prose-mirror name="system.description" value="{{system.description}}" toggled></prose-mirror>
      </label>

      {{#if abilityImplementations.length}}
        <div class="fast-nri-implementation-tabs" role="tablist" aria-label="Реализации способности">
          {{#each abilityImplementations as |impl|}}
            <button type="button" role="tab" class="fast-nri-implementation-tab {{#if impl.active}}active{{/if}}"
              data-fast-nri-implementation-tab="{{impl.id}}" aria-selected="{{#if impl.active}}true{{else}}false{{/if}}" title="{{impl.costLabel}}">
              <span>{{impl.name}}</span>
            </button>
          {{/each}}
          <button type="button" class="fast-nri-implementation-tab-add" data-action="addImplementation" title="Добавить реализацию"><i class="fa-solid fa-plus"></i></button>
        </div>
        <div class="fast-nri-implementation-panes">
          {{#each abilityImplementations as |impl|}}
            <div class="fast-nri-implementation-card fast-nri-implementation-pane {{#if impl.active}}active{{/if}}" data-fast-nri-implementation-pane="{{impl.id}}">
              <div class="fast-nri-implementation-pane-heading">
                <div><strong>{{impl.name}}</strong><small>{{impl.costLabel}}{{#if impl.traitLabel}} · {{impl.traitLabel}}{{/if}}</small></div>
                <div class="fast-nri-inline-actions">
                  <button type="button" data-action="duplicateImplementation" data-implementation-index="{{impl.index}}" title="Дублировать"><i class="fa-solid fa-copy"></i></button>
                  <button type="button" data-action="removeImplementation" data-implementation-index="{{impl.index}}" title="Удалить"><i class="fa-solid fa-trash"></i></button>
                </div>
              </div>

              <input type="hidden" name="system.implementations.{{impl.index}}.id" value="{{impl.id}}" />
              <div class="fast-nri-form-grid two-columns">
                <label>Название кнопки / реализации
                  <input type="text" name="system.implementations.{{impl.index}}.name" value="{{impl.implementation.name}}" />
                </label>
                <label>Свойства
                  <multi-select name="system.implementations.{{impl.index}}.traitIds">
                    {{selectOptions @root.abilityTraitChoices selected=impl.implementation.traitIds}}
                  </multi-select>
                </label>
              </div>

              <label>Описание реализации
                <prose-mirror name="system.implementations.{{impl.index}}.description" value="{{impl.implementation.description}}" toggled></prose-mirror>
              </label>

              <h3>Требуется</h3>
              <div class="fast-nri-form-grid four-columns">
                <label>Воздействия <input type="number" min="0" name="system.implementations.{{impl.index}}.costs.action" value="{{impl.implementation.costs.action}}" /></label>
                <label>Движения <input type="number" min="0" name="system.implementations.{{impl.index}}.costs.movement" value="{{impl.implementation.costs.movement}}" /></label>
                <label>Вмешательства <input type="number" min="0" name="system.implementations.{{impl.index}}.costs.intervention" value="{{impl.implementation.costs.intervention}}" /></label>
                <label>Классовый ресурс <input type="number" min="0" name="system.implementations.{{impl.index}}.costs.classResource" value="{{impl.implementation.costs.classResource}}" /></label>
              </div>
              <label class="fast-nri-checkbox-label"><input type="checkbox" name="system.implementations.{{impl.index}}.costs.freeAction" {{#if impl.implementation.costs.freeAction}}checked{{/if}} /><span>Свободное действие</span></label>
              <label>Дополнительная цена / требование
                <prose-mirror name="system.implementations.{{impl.index}}.costs.additionalText" value="{{impl.implementation.costs.additionalText}}" toggled></prose-mirror>
              </label>

              <h3>Независимые разрешения</h3>
              <div class="fast-nri-form-grid two-columns">
                <label>Количество
                  <input type="number" min="1" name="system.implementations.{{impl.index}}.repeat.count" value="{{impl.implementation.repeat.count}}" />
                </label>
                <label>Название одного результата
                  <input type="text" name="system.implementations.{{impl.index}}.repeat.label" value="{{impl.implementation.repeat.label}}" placeholder="Стрела / Заряд / Атака" />
                </label>
              </div>
              <small class="fast-nri-help">Например: реализация «3 стрелы» имеет фиксированную цену и 3 независимых разрешения с отдельными бросками.</small>

              <h3>Условия и требования</h3>
              <label>Условие <prose-mirror name="system.implementations.{{impl.index}}.conditionText" value="{{impl.implementation.conditionText}}" toggled></prose-mirror></label>
              <label>Требование <prose-mirror name="system.implementations.{{impl.index}}.requirementText" value="{{impl.implementation.requirementText}}" toggled></prose-mirror></label>
              <label>Ограничение <prose-mirror name="system.implementations.{{impl.index}}.limitationText" value="{{impl.implementation.limitationText}}" toggled></prose-mirror></label>
              <label>Исключение <prose-mirror name="system.implementations.{{impl.index}}.exceptionText" value="{{impl.implementation.exceptionText}}" toggled></prose-mirror></label>

              <h3>Цель и дистанция</h3>
              <div class="fast-nri-form-grid two-columns">
                <label>Режим цели <select name="system.implementations.{{impl.index}}.targeting.mode">{{selectOptions @root.abilityTargetModeChoices selected=impl.implementation.targeting.mode}}</select></label>
                <label>Отношение <select name="system.implementations.{{impl.index}}.targeting.relation">{{selectOptions @root.abilityTargetRelationChoices selected=impl.implementation.targeting.relation}}</select></label>
                <label>Мин. целей <input type="number" min="0" name="system.implementations.{{impl.index}}.targeting.countMin" value="{{impl.implementation.targeting.countMin}}" /></label>
                <label>Макс. целей <input type="number" min="0" name="system.implementations.{{impl.index}}.targeting.countMax" value="{{impl.implementation.targeting.countMax}}" /></label>
                <label>Дистанция <select name="system.implementations.{{impl.index}}.targeting.rangeMode">{{selectOptions @root.abilityRangeModeChoices selected=impl.implementation.targeting.rangeMode}}</select></label>
                <label>Клеток <input type="number" min="0" name="system.implementations.{{impl.index}}.targeting.rangeCells" value="{{impl.implementation.targeting.rangeCells}}" /></label>
              </div>
              <label class="fast-nri-checkbox-label"><input type="checkbox" name="system.implementations.{{impl.index}}.targeting.requiresVisibility" {{#if impl.implementation.targeting.requiresVisibility}}checked{{/if}} /><span>Требует видимость</span></label>
              <label>Частное правило цели <prose-mirror name="system.implementations.{{impl.index}}.targeting.text" value="{{impl.implementation.targeting.text}}" toggled></prose-mirror></label>

              <div class="fast-nri-area-editor-heading">
                <div><h3>Области</h3><small class="fast-nri-help">Можно задать несколько вариантов одной реализации. Стандартные области перетаскиваются из chat-card на карту; «Особая» остаётся только текстом.</small></div>
                <button type="button" data-action="addImplementationArea" data-implementation-index="{{impl.index}}"><i class="fa-solid fa-plus"></i> Область</button>
              </div>
              {{#if impl.areas.length}}
                <div class="fast-nri-area-editor-list">
                  {{#each impl.areas as |area|}}
                    <div class="fast-nri-area-editor-row">
                      <input type="hidden" name="system.implementations.{{impl.index}}.areas.{{area.index}}.id" value="{{area.id}}" />
                      <div class="fast-nri-form-grid two-columns">
                        <label>Тип <select name="system.implementations.{{impl.index}}.areas.{{area.index}}.type">{{selectOptions @root.abilityAreaPresetChoices selected=area.type}}</select></label>
                        <label>Подпись <input type="text" name="system.implementations.{{impl.index}}.areas.{{area.index}}.label" value="{{area.label}}" placeholder="{{area.labelText}}" /></label>
                      </div>
                      {{#if area.isSquare}}
                        <label>Размер квадрата, клеток <input type="number" min="1" name="system.implementations.{{impl.index}}.areas.{{area.index}}.width" value="{{area.width}}" /></label>
                      {{/if}}
                      {{#if area.isRectangle}}
                        <div class="fast-nri-form-grid two-columns"><label>Ширина, клеток <input type="number" min="1" name="system.implementations.{{impl.index}}.areas.{{area.index}}.width" value="{{area.width}}" /></label><label>Высота, клеток <input type="number" min="1" name="system.implementations.{{impl.index}}.areas.{{area.index}}.height" value="{{area.height}}" /></label></div>
                      {{/if}}
                      {{#if area.isLine}}
                        <div class="fast-nri-form-grid two-columns"><label>Длина, клеток <input type="number" min="1" name="system.implementations.{{impl.index}}.areas.{{area.index}}.length" value="{{area.length}}" /></label><label>Ширина, клеток <input type="number" min="1" name="system.implementations.{{impl.index}}.areas.{{area.index}}.lineWidth" value="{{area.lineWidth}}" /></label></div>
                      {{/if}}
                      {{#if area.isSpecial}}
                        <label>Описание особой геометрии <prose-mirror name="system.implementations.{{impl.index}}.areas.{{area.index}}.text" value="{{area.text}}" toggled></prose-mirror></label>
                      {{/if}}
                      <button type="button" class="fast-nri-area-remove" data-action="removeImplementationArea" data-implementation-index="{{impl.index}}" data-area-index="{{area.index}}"><i class="fa-solid fa-trash"></i> Удалить область</button>
                    </div>
                  {{/each}}
                </div>
              {{else}}
                <small class="fast-nri-help">Область: нет.</small>
              {{/if}}

              <h3>Проверка</h3>
              <label class="fast-nri-checkbox-label"><input type="checkbox" name="system.implementations.{{impl.index}}.check.enabled" {{#if impl.implementation.check.enabled}}checked{{/if}} /><span>Есть Check</span></label>
              {{#if impl.implementation.check.enabled}}
                <div class="fast-nri-form-grid two-columns">
                  <label>Формула <input type="text" name="system.implementations.{{impl.index}}.check.formula" value="{{impl.implementation.check.formula}}" /></label>
                  <label>Против характеристики
                    <select name="system.implementations.{{impl.index}}.check.targetCharacteristic">
                      <option value="armor" {{#if (eq impl.implementation.check.targetCharacteristic "armor")}}selected{{/if}}>КЗ</option>
                      <option value="awareness" {{#if (eq impl.implementation.check.targetCharacteristic "awareness")}}selected{{/if}}>Внимательность</option>
                      <option value="reflex" {{#if (eq impl.implementation.check.targetCharacteristic "reflex")}}selected{{/if}}>Рефлекс</option>
                      <option value="fortitude" {{#if (eq impl.implementation.check.targetCharacteristic "fortitude")}}selected{{/if}}>Стойкость</option>
                      <option value="will" {{#if (eq impl.implementation.check.targetCharacteristic "will")}}selected{{/if}}>Воля</option>
                    </select>
                  </label>
                </div>
                <label class="fast-nri-checkbox-label"><input type="checkbox" name="system.implementations.{{impl.index}}.defenseProcedure.directedDefense" {{#if impl.implementation.defenseProcedure.directedDefense}}checked{{/if}} /><span>Направленная защита</span></label>
              {{/if}}

              <h3>Профили по степени</h3>
              {{#each impl.profiles as |profile|}}
                <section class="fast-nri-result-profile {{#if profile.enabled}}enabled{{/if}}">
                  <header><label class="fast-nri-checkbox-label"><input type="checkbox" name="system.implementations.{{impl.index}}.profiles.{{profile.degree}}.enabled" {{#if profile.enabled}}checked{{/if}} /><span><strong>{{profile.label}}</strong></span></label></header>
                  <label>Rich text результата <prose-mirror name="system.implementations.{{impl.index}}.profiles.{{profile.degree}}.text" value="{{profile.text}}" toggled></prose-mirror></label>
                  {{#each profile.channels as |channel|}}
                    <div class="fast-nri-outcome-channel {{#if channel.enabled}}enabled{{/if}}">
                      <div class="fast-nri-outcome-channel-heading">
                        <label class="fast-nri-checkbox-label"><input type="checkbox" name="system.implementations.{{impl.index}}.profiles.{{profile.degree}}.{{channel.kind}}.enabled" {{#if channel.enabled}}checked{{/if}} /><span>{{channel.label}}</span></label>
                        <button type="button" data-action="addImplementationProfileComponent" data-implementation-index="{{impl.index}}" data-degree="{{profile.degree}}" data-outcome-kind="{{channel.kind}}"><i class="fa-solid fa-plus"></i> Компонент</button>
                      </div>
                      {{#if channel.isDamage}}
                        <div class="fast-nri-form-grid three-columns">
                          <label>Убрать больших <input type="number" min="0" name="system.implementations.{{impl.index}}.profiles.{{profile.degree}}.damage.removeHighest" value="{{channel.removeHighest}}" /></label>
                          <label>Убрать малых <input type="number" min="0" name="system.implementations.{{impl.index}}.profiles.{{profile.degree}}.damage.removeLowest" value="{{channel.removeLowest}}" /></label>
                          <label class="fast-nri-checkbox-label"><input type="checkbox" name="system.implementations.{{impl.index}}.profiles.{{profile.degree}}.damage.removeAll" {{#if channel.removeAll}}checked{{/if}} /><span>Убрать все</span></label>
                        </div>
                      {{/if}}
                      {{#each channel.components as |component|}}
                        <div class="fast-nri-outcome-component-row">
                          <input type="text" name="system.implementations.{{impl.index}}.profiles.{{profile.degree}}.{{channel.kind}}.components.{{component.index}}.formula" value="{{component.formula}}" />
                          {{#if channel.isDamage}}
                            <select name="system.implementations.{{impl.index}}.profiles.{{profile.degree}}.{{channel.kind}}.components.{{component.index}}.damageType"><option value="physical" {{#if (eq component.damageType "physical")}}selected{{/if}}>Физический</option><option value="magic" {{#if (eq component.damageType "magic")}}selected{{/if}}>Магический</option></select>
                            <multi-select name="system.implementations.{{impl.index}}.profiles.{{profile.degree}}.{{channel.kind}}.components.{{component.index}}.traitIds">{{selectOptions @root.damageTraitChoices selected=component.traitIds}}</multi-select>
                          {{/if}}
                          <button type="button" data-action="removeImplementationProfileComponent" data-implementation-index="{{impl.index}}" data-degree="{{profile.degree}}" data-outcome-kind="{{channel.kind}}" data-index="{{component.index}}"><i class="fa-solid fa-trash"></i></button>
                        </div>
                      {{/each}}
                    </div>
                  {{/each}}
                  <div class="fast-nri-profile-effect-dropzone" data-fast-nri-implementation-profile-effect-dropzone data-implementation-index="{{impl.index}}" data-degree="{{profile.degree}}"><i class="fa-solid fa-link"></i> Перетащите Effect для этой степени</div>
                  {{#each profile.effects as |effect|}}<div class="fast-nri-linked-effect-row"><img src="{{effect.img}}" /><span>{{effect.name}}</span><small>{{effect.durationLabel}}</small><button type="button" data-action="removeImplementationProfileEffect" data-implementation-index="{{impl.index}}" data-degree="{{profile.degree}}" data-effect-uuid="{{effect.uuid}}"><i class="fa-solid fa-xmark"></i></button></div>{{/each}}
                </section>
              {{/each}}

              <h3>Защитная реализация</h3>
              <label class="fast-nri-checkbox-label"><input type="checkbox" name="system.implementations.{{impl.index}}.defenseAction.enabled" {{#if impl.implementation.defenseAction.enabled}}checked{{/if}} /><span>Предлагать обработчиком кнопки «Защита» выбранного токена</span></label>
              {{#if impl.implementation.defenseAction.enabled}}
                <div class="fast-nri-form-grid two-columns">
                  <label>Процедура <select name="system.implementations.{{impl.index}}.defenseAction.procedure">{{selectOptions @root.defenseProcedureChoices selected=impl.implementation.defenseAction.procedure}}</select></label>
                  <label>Кого защищает <select name="system.implementations.{{impl.index}}.defenseAction.targetScope">{{selectOptions @root.defenseTargetScopeChoices selected=impl.implementation.defenseAction.targetScope}}</select></label>
                  <label>Цена Вмешательства <input type="number" min="0" name="system.implementations.{{impl.index}}.defenseAction.interventionCost" value="{{impl.implementation.defenseAction.interventionCost}}" /></label>
                  <label>Дистанция <select name="system.implementations.{{impl.index}}.defenseAction.rangeMode">{{selectOptions @root.defenseRangeModeChoices selected=impl.implementation.defenseAction.rangeMode}}</select></label>
                  <label>Клеток <input type="number" min="0" name="system.implementations.{{impl.index}}.defenseAction.rangeCells" value="{{impl.implementation.defenseAction.rangeCells}}" /></label>
                  <label>Формула боевых кубов <input type="text" name="system.implementations.{{impl.index}}.defenseAction.combatDiceFormula" value="{{impl.implementation.defenseAction.combatDiceFormula}}" /></label>
                  <label>Удалить частей урона <input type="number" min="0" name="system.implementations.{{impl.index}}.defenseAction.removeDamageParts" value="{{impl.implementation.defenseAction.removeDamageParts}}" /></label>
                  <label>Снижение степени Эффекта <input type="number" min="0" name="system.implementations.{{impl.index}}.defenseAction.effectDegreeReduction" value="{{impl.implementation.defenseAction.effectDegreeReduction}}" /></label>
                  <label>Выбор частей <select name="system.implementations.{{impl.index}}.defenseAction.damageSelectionMode">{{selectOptions @root.defenseDamageSelectionChoices selected=impl.implementation.defenseAction.damageSelectionMode}}</select></label>
                  <label>Перемещение <select name="system.implementations.{{impl.index}}.defenseAction.movementMode">{{selectOptions @root.defenseMovementModeChoices selected=impl.implementation.defenseAction.movementMode}}</select></label>
                </div>
                <label class="fast-nri-checkbox-label"><input type="checkbox" name="system.implementations.{{impl.index}}.defenseAction.requiresVisibility" {{#if impl.implementation.defenseAction.requiresVisibility}}checked{{/if}} /><span>Требует видимость</span></label>
                <label class="fast-nri-checkbox-label"><input type="checkbox" name="system.implementations.{{impl.index}}.defenseAction.allowManeuver" {{#if impl.implementation.defenseAction.allowManeuver}}checked{{/if}} /><span>Можно против Манёвра</span></label>
              {{/if}}

              <h3>Эффекты реализации</h3>
              <div class="fast-nri-effect-link-dropzone" data-fast-nri-implementation-effect-dropzone data-implementation-index="{{impl.index}}"><i class="fa-solid fa-link"></i> Перетащите Effect</div>
              {{#each impl.effects as |effect|}}<div class="fast-nri-linked-effect-row"><img src="{{effect.img}}" /><span>{{effect.name}}</span><small>{{effect.durationLabel}}</small><button type="button" data-action="removeImplementationEffect" data-implementation-index="{{impl.index}}" data-effect-uuid="{{effect.uuid}}"><i class="fa-solid fa-xmark"></i></button></div>{{/each}}
            </div>
          {{/each}}
        </div>
      {{else}}
        <div class="fast-nri-empty-state"><p>У способности ещё нет реализации.</p><button type="button" data-action="addImplementation"><i class="fa-solid fa-plus"></i> Создать основную реализацию</button></div>
      {{/if}}

      <details class="fast-nri-implementation-card">
        <summary><strong>Общие пассивные правила</strong><small>Не относятся к отдельной реализации</small></summary>
        <label class="fast-nri-checkbox-label"><input type="checkbox" name="system.defenseModifier.enabled" {{#if system.defenseModifier.enabled}}checked{{/if}} /><span>Модификатор Защитных действий</span></label>
        {{#if system.defenseModifier.enabled}}
          <div class="fast-nri-form-grid two-columns"><label>Область <select name="system.defenseModifier.scope">{{selectOptions defenseModifierScopeChoices selected=system.defenseModifier.scope}}</select></label><label>Формула <input type="text" name="system.defenseModifier.combatDiceFormula" value="{{system.defenseModifier.combatDiceFormula}}" /></label></div>
        {{/if}}
        <div class="fast-nri-form-grid three-columns"><label>Строй себе <input type="number" name="system.rules.formation.selfBonus" value="{{system.rules.formation.selfBonus}}" /></label><label>Строй соседям <input type="number" name="system.rules.formation.adjacentAllyBonus" value="{{system.rules.formation.adjacentAllyBonus}}" /></label><label>Штраф Строя цели <input type="number" name="system.rules.formation.targetPenalty" value="{{system.rules.formation.targetPenalty}}" /></label></div>
      </details>
    </section>
  {{/if}}

  {{#if isEquipment}}
    <section class="fast-nri-section">
      <h2>Снаряжение</h2>
      <div class="fast-nri-two">
        <label>
          Категория
          <input type="text" name="system.category" value="{{system.category}}" />
        </label>
        <div class="fast-nri-item-equip-config">
          <label class="fast-nri-checkbox-label" title="Активен и учитывается в системных расчётах">
            <input
              type="checkbox"
              data-fast-nri-item-equipped
              {{#if system.equipped}}checked{{/if}}
            />
            Экипирован
          </label>

          {{#if showHeldToggle}}
            <label class="fast-nri-checkbox-label" title="Физически находится в руках">
              <input
                type="checkbox"
                data-fast-nri-item-held
                {{#if system.held}}checked{{/if}}
              />
              В руках
            </label>
          {{/if}}

          <label>
            Требует рук
            <select data-fast-nri-item-hands>
              <option value="0" {{#if (eq system.hands 0)}}selected{{/if}}>Не требует</option>
              <option value="1" {{#if (eq system.hands 1)}}selected{{/if}}>1</option>
              <option value="2" {{#if (eq system.hands 2)}}selected{{/if}}>2</option>
            </select>
          </label>
        </div>
      </div>

      <label class="fast-nri-property-field">
        Свойства
        <multi-select name="system.propertyIds">
          {{selectOptions propertyChoices selected=system.propertyIds}}
        </multi-select>
      </label>
    </section>
  {{/if}}

  {{#if isConsumable}}
    <section class="fast-nri-section">
      <h2>Расходник</h2>
      <label>
        Количество
        <input type="number" name="system.quantity" value="{{system.quantity}}" />
      </label>
    </section>
  {{/if}}

  {{#if isEffect}}
    <section class="fast-nri-section">
      <div class="fast-nri-section-heading">
        <div>
          <h2>Effect</h2>
          <p class="fast-nri-help">
            Пока Effect только отслеживает длительность и стаки. Игровых штрафов,
            бонусов и ограничений он автоматически не применяет.
          </p>
        </div>

        <button type="button" data-action="sendEffectToChat">
          <i class="fa-solid fa-message"></i>
          В чат
        </button>
      </div>

      <div class="fast-nri-two">
        <label>
          Вид
          <select name="system.effectKind">
            {{selectOptions effectKindChoices selected=system.effectKind}}
          </select>
        </label>

        <label>
          Стаки
          <select name="system.stacking.mode">
            {{selectOptions effectStackingChoices selected=system.stacking.mode}}
          </select>
        </label>
      </div>

      <div class="fast-nri-two">
        <label>
          Длительность
          <select name="system.duration.mode">
            {{selectOptions effectDurationChoices selected=system.duration.mode}}
          </select>
        </label>

        {{#if (eq system.duration.mode "rounds")}}
          <label>
            Раундов
            <input
              type="number"
              min="1"
              name="system.duration.rounds"
              value="{{system.duration.rounds}}"
            />
          </label>
        {{/if}}
      </div>

      {{#if (eq system.duration.mode "rounds")}}
        <label>
          Снимать
          <select name="system.duration.expiry">
            {{selectOptions effectExpiryChoices selected=system.duration.expiry}}
          </select>
        </label>
      {{/if}}

      <div class="fast-nri-effect-definition-summary">
        <strong>{{effectDurationLabel}}</strong>
      </div>

      <div class="fast-nri-formation-rules">
        <h3>Модификаторы Строя</h3>
        <div class="fast-nri-three">
          <label>Бонус себе
            <input type="number" min="0" name="system.rules.formation.selfBonus" value="{{system.rules.formation.selfBonus}}" />
          </label>
          <label>Бонус соседним союзникам
            <input type="number" min="0" name="system.rules.formation.adjacentAllyBonus" value="{{system.rules.formation.adjacentAllyBonus}}" />
          </label>
          <label>Штраф Строю цели для владельца
            <input type="number" min="0" name="system.rules.formation.targetPenalty" value="{{system.rules.formation.targetPenalty}}" />
          </label>
        </div>
        <small class="fast-nri-help">Машинные модификаторы действуют только пока этот Effect находится на Actor.</small>
      </div>

      <div class="fast-nri-effect-rule-flags">
        <label class="fast-nri-checkbox-label" title="Только для вычисления состояния поля; кнопки атак не блокируются">
          <input
            type="checkbox"
            name="system.rules.disableMeleeControl"
            {{#if system.rules.disableMeleeControl}}checked{{/if}}
          />
          Отключает контроль ближнего боя
        </label>
        <small>Машинное свойство: пока Effect действует, существо не создаёт контролируемых клеток ближнего боя.</small>
      </div>

      {{#if item.isEmbedded}}
        <div class="fast-nri-effect-runtime-summary">
          <span>Наложено на: <strong>{{item.parent.name}}</strong></span>
          <span>Стаков: <strong>{{effectRuntimeStackCount}}</strong></span>
          <span>{{effectRuntimeDuration}}</span>
          <small>ПКМ по иконке в панели эффектов снимает один стак.</small>
        </div>
      {{/if}}
    </section>
  {{/if}}

  {{#unless isAbility}}
    <section class="fast-nri-section">
      <h2>Описание</h2>
      <prose-mirror name="system.description" value="{{system.description}}" toggled></prose-mirror>
    </section>
  {{/unless}}
</div>
