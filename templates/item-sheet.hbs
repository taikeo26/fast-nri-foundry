<div class="fast-nri-sheet fast-nri-item" autocomplete="off">
  <header class="fast-nri-header">
    <img class="fast-nri-portrait" src="{{item.img}}" alt="{{item.name}}" />

    <div class="fast-nri-identity">
      <input class="fast-nri-name" type="text" name="name" value="{{item.name}}" />
      <div class="fast-nri-subline">
        <span>{{item.type}}</span>
        {{#unless isEffect}}
          <label>
            Уровень
            <input type="number" name="system.level" value="{{system.level}}" />
          </label>
        {{/unless}}
      </div>
    </div>
  </header>

  {{#if isWeapon}}
    <section class="fast-nri-section">
      <h2>Оружие</h2>
      <div class="fast-nri-two">
        <label>
          Дистанция
          <input type="text" name="system.range" value="{{system.range}}" />
        </label>
        <label>
          Тип урона
          <select name="system.damageType">
            <option value="physical" {{#if (eq system.damageType "physical")}}selected{{/if}}>Физический</option>
            <option value="magic" {{#if (eq system.damageType "magic")}}selected{{/if}}>Магический</option>
          </select>
        </label>
      </div>


      <div class="fast-nri-two">
        <label class="fast-nri-property-field">
          Свойства
          <multi-select name="system.propertyIds">
            {{selectOptions propertyChoices selected=system.propertyIds}}
          </multi-select>
        </label>
        <div class="fast-nri-item-equip-config">
          <label class="fast-nri-checkbox-label" title="Активен и учитывается в системных расчётах">
            <input
              type="checkbox"
              data-fast-nri-item-equipped
              {{#if system.equipped}}checked{{/if}}
            />
            Экипирован
          </label>

          {{#if showHeldToggle}}
            <label class="fast-nri-checkbox-label" title="Физически находится в руках">
              <input
                type="checkbox"
                data-fast-nri-item-held
                {{#if system.held}}checked{{/if}}
              />
              В руках
            </label>
          {{/if}}

          <label>
            Требует рук
            <select data-fast-nri-item-hands>
              <option value="0" {{#if (eq system.hands 0)}}selected{{/if}}>Не требует</option>
              <option value="1" {{#if (eq system.hands 1)}}selected{{/if}}>1</option>
              <option value="2" {{#if (eq system.hands 2)}}selected{{/if}}>2</option>
            </select>
          </label>
        </div>
      </div>

      <div class="fast-nri-three">
        <label>Частичный — базовая формула
          <input type="text" name="system.damage.partial" value="{{system.damage.partial}}" />
        </label>
        <label>Успех — базовая формула
          <input type="text" name="system.damage.success" value="{{system.damage.success}}" />
        </label>
        <label>Большой — базовая формула
          <input type="text" name="system.damage.great" value="{{system.damage.great}}" />
        </label>
      </div>

      <div class="fast-nri-damage-composition">
        <div class="fast-nri-damage-composition-heading">
          <h3>Состав урона</h3>
          <small>Если профиль содержит компоненты ниже, они заменяют его базовую формулу.</small>
        </div>

        {{#each damageComponentProfiles as |profile|}}
          <section class="fast-nri-damage-component-profile">
            <div class="fast-nri-damage-component-profile-heading">
              <strong>{{profile.label}}</strong>
              <button
                type="button"
                data-action="addDamageComponent"
                data-profile="{{profile.id}}"
                title="Добавить компонент урона"
              >
                <i class="fa-solid fa-plus"></i>
                Компонент
              </button>
            </div>

            {{#if profile.components.length}}
              <div class="fast-nri-damage-component-list">
                {{#each profile.components as |component|}}
                  <div class="fast-nri-damage-component-row">
                    <input
                      type="text"
                      value="{{component.formula}}"
                      data-fast-nri-damage-component-field="formula"
                      data-profile="{{profile.id}}"
                      data-index="{{component.index}}"
                      title="Формула компонента"
                    />

                    <select
                      data-fast-nri-damage-component-field="damageType"
                      data-profile="{{profile.id}}"
                      data-index="{{component.index}}"
                      title="Тип урона компонента"
                    >
                      <option value="physical" {{#if (eq component.damageType "physical")}}selected{{/if}}>Физический</option>
                      <option value="magic" {{#if (eq component.damageType "magic")}}selected{{/if}}>Магический</option>
                    </select>

                    <multi-select
                      data-fast-nri-damage-component-field="traitIds"
                      data-profile="{{profile.id}}"
                      data-index="{{component.index}}"
                      title="Свойства этого компонента"
                    >
                      {{selectOptions @root.damageTraitChoices selected=component.traitIds}}
                    </multi-select>

                    <button
                      type="button"
                      class="fast-nri-damage-component-remove"
                      data-action="removeDamageComponent"
                      data-profile="{{profile.id}}"
                      data-index="{{component.index}}"
                      title="Удалить компонент"
                    >
                      <i class="fa-solid fa-trash"></i>
                    </button>
                  </div>
                {{/each}}
              </div>
            {{else}}
              <small class="fast-nri-help">Используется базовая формула профиля и общий тип урона оружия.</small>
            {{/if}}
          </section>
        {{/each}}
      </div>
    </section>
  {{/if}}

  {{#if isAbility}}
    <section class="fast-nri-section">
      <h2>{{#if abilityIsSpell}}Заклинание{{else}}Способность{{/if}}</h2>

      <div class="fast-nri-two">
        <label>
          Категория
          <select name="system.category">
            <option value="ability" {{#if (eq system.category "ability")}}selected{{/if}}>Способность</option>
            <option value="spell" {{#if (eq system.category "spell")}}selected{{/if}}>Заклинание</option>
          </select>
        </label>

        <label>
          Время использования
          <input type="text" name="system.timing" value="{{system.timing}}" />
        </label>
      </div>

      <label>
        Стоимость классового ресурса
        <input type="number" name="system.classResourceCost" value="{{system.classResourceCost}}" />
      </label>

      <div class="fast-nri-ability-attack-config">
        <h3>Исходная Атака против КЗ</h3>

        <label class="fast-nri-checkbox-label">
          <input
            type="checkbox"
            name="system.attackCheck.enabled"
            {{#if system.attackCheck.enabled}}checked{{/if}}
          />
          <span>Перед результатами выполнить Атаку против КЗ</span>
        </label>

        {{#if system.attackCheck.enabled}}
          <label>
            Формула проверки
            <input
              type="text"
              name="system.attackCheck.formula"
              value="{{system.attackCheck.formula}}"
              placeholder="1d20 + {combatDie}"
            />
          </label>

          <small class="fast-nri-help">
            Маркер <code>{combatDie}</code> автоматически заменяется текущим Кубом боя Actor.
            Для особой способности можно записать другую формулу вручную.
          </small>

          <label class="fast-nri-checkbox-label">
            <input
              type="checkbox"
              name="system.attackCheck.directedDefense"
              {{#if system.attackCheck.directedDefense}}checked{{/if}}
            />
            <span>Разрешить Направленную защиту от этого урона</span>
          </label>

          <small class="fast-nri-help">
            Включайте только когда карточка действия действительно допускает Направленную защиту.
            Для Области действия или урона без подходящей исходной проверки оставляйте выключенным.
          </small>
        {{/if}}
      </div>

      <div class="fast-nri-ability-defense-config">
        <h3>Защитное действие</h3>

        <label class="fast-nri-checkbox-label">
          <input
            type="checkbox"
            name="system.defenseAction.enabled"
            {{#if system.defenseAction.enabled}}checked{{/if}}
          />
          <span>Показывать эту способность как способ защиты</span>
        </label>

        {{#if system.defenseAction.enabled}}
          <div class="fast-nri-two">
            <label>
              Кого можно защищать
              <select name="system.defenseAction.targetScope">
                {{selectOptions defenseTargetScopeChoices selected=system.defenseAction.targetScope}}
              </select>
            </label>

            <label>
              Вмешательств
              <input
                type="number"
                min="0"
                name="system.defenseAction.interventionCost"
                value="{{system.defenseAction.interventionCost}}"
              />
            </label>
          </div>

          <div class="fast-nri-two">
            <label>
              Дистанция
              <select name="system.defenseAction.rangeMode">
                {{selectOptions defenseRangeModeChoices selected=system.defenseAction.rangeMode}}
              </select>
            </label>

            {{#if (eq system.defenseAction.rangeMode "cells")}}
              <label>
                Клеток
                <input
                  type="number"
                  min="0"
                  name="system.defenseAction.rangeCells"
                  value="{{system.defenseAction.rangeCells}}"
                />
              </label>
            {{else}}
              <label>
                Перемещение
                <select name="system.defenseAction.movementMode">
                  {{selectOptions defenseMovementModeChoices selected=system.defenseAction.movementMode}}
                </select>
              </label>
            {{/if}}
          </div>

          <label class="fast-nri-checkbox-label">
            <input
              type="checkbox"
              name="system.defenseAction.requiresVisibility"
              {{#if system.defenseAction.requiresVisibility}}checked{{/if}}
            />
            <span>Требует видимую защищаемую цель</span>
          </label>

          <div class="fast-nri-two">
            <label>
              Кубы Боевой подготовки
              <input
                type="text"
                name="system.defenseAction.combatDiceFormula"
                value="{{system.defenseAction.combatDiceFormula}}"
                placeholder="пусто = обычная формула Actor"
              />
            </label>

            <label>
              Удалить частей урона
              <input
                type="number"
                min="0"
                name="system.defenseAction.removeDamageParts"
                value="{{system.defenseAction.removeDamageParts}}"
              />
            </label>
          </div>

          <label>
            Какие части удалять
            <select name="system.defenseAction.damageSelectionMode">
              {{selectOptions defenseDamageSelectionChoices selected=system.defenseAction.damageSelectionMode}}
            </select>
          </label>

          <div class="fast-nri-two">
            <label>
              Снизить степень Эффекта на
              <input
                type="number"
                min="0"
                name="system.defenseAction.effectDegreeReduction"
                value="{{system.defenseAction.effectDegreeReduction}}"
              />
            </label>

            <label class="fast-nri-checkbox-label fast-nri-defense-inline-checkbox">
              <input
                type="checkbox"
                name="system.defenseAction.allowManeuver"
                {{#if system.defenseAction.allowManeuver}}checked{{/if}}
              />
              <span>Разрешает защиту от Манёвра</span>
            </label>
          </div>

          <small class="fast-nri-help">
            Базовые ресурсы здесь только показываются и предупреждают — система их не списывает.
            Стоимость классового ресурса берётся из общего поля способности выше и списывается мягко.
          </small>
        {{/if}}
      </div>

      <div class="fast-nri-ability-defense-config">
        <h3>Модификатор Защитных действий</h3>

        <label class="fast-nri-checkbox-label">
          <input
            type="checkbox"
            name="system.defenseModifier.enabled"
            {{#if system.defenseModifier.enabled}}checked{{/if}}
          />
          <span>Эта способность меняет формулу Защитных действий</span>
        </label>

        {{#if system.defenseModifier.enabled}}
          <div class="fast-nri-two">
            <label>
              Область действия
              <select name="system.defenseModifier.scope">
                {{selectOptions defenseModifierScopeChoices selected=system.defenseModifier.scope}}
              </select>
            </label>

            <label>
              Кубы Боевой подготовки
              <input
                type="text"
                name="system.defenseModifier.combatDiceFormula"
                value="{{system.defenseModifier.combatDiceFormula}}"
                placeholder="например 2d6"
              />
            </label>
          </div>
        {{/if}}
      </div>

      <div class="fast-nri-ability-outcome-config">
        <h3>Автоматические результаты</h3>
        <small class="fast-nri-help">
          Одна способность или заклинание может иметь несколько результатов одновременно.
          Например, Лечение и Временные HP настраиваются отдельно и оба появятся в карточке использования.
        </small>

        <div class="fast-nri-outcome-channel-list">
          {{#each outcomeChannels as |outcome|}}
            <section class="fast-nri-outcome-channel {{#if outcome.enabled}}enabled{{/if}}">
              <div class="fast-nri-outcome-channel-heading">
                <label class="fast-nri-checkbox-label">
                  <input
                    type="checkbox"
                    data-fast-nri-outcome-enabled
                    data-outcome-kind="{{outcome.kind}}"
                    {{#if outcome.enabled}}checked{{/if}}
                  />
                  <i class="fa-solid {{outcome.icon}}"></i>
                  <strong>{{outcome.label}}</strong>
                </label>

                {{#if outcome.enabled}}
                  <button
                    type="button"
                    data-action="addOutcomeComponent"
                    data-outcome-kind="{{outcome.kind}}"
                    title="Добавить компонент"
                  >
                    <i class="fa-solid fa-plus"></i>
                    Компонент
                  </button>
                {{/if}}
              </div>

              {{#if outcome.enabled}}
                <div class="fast-nri-outcome-component-list">
                  {{#each outcome.components as |component|}}
                    <div class="fast-nri-outcome-component-row {{#if outcome.isDamage}}is-damage{{else}}is-hp-gain{{/if}}">
                      <input
                        type="text"
                        value="{{component.formula}}"
                        data-fast-nri-outcome-component-field="formula"
                        data-outcome-kind="{{outcome.kind}}"
                        data-index="{{component.index}}"
                        title="Формула компонента"
                      />

                      {{#if outcome.isDamage}}
                        <select
                          data-fast-nri-outcome-component-field="damageType"
                          data-outcome-kind="{{outcome.kind}}"
                          data-index="{{component.index}}"
                          title="Тип урона компонента"
                        >
                          <option value="physical" {{#if (eq component.damageType "physical")}}selected{{/if}}>Физический</option>
                          <option value="magic" {{#if (eq component.damageType "magic")}}selected{{/if}}>Магический</option>
                        </select>

                        <multi-select
                          data-fast-nri-outcome-component-field="traitIds"
                          data-outcome-kind="{{outcome.kind}}"
                          data-index="{{component.index}}"
                          title="Свойства компонента урона"
                        >
                          {{selectOptions @root.damageTraitChoices selected=component.traitIds}}
                        </multi-select>
                      {{else}}
                        <multi-select
                          data-fast-nri-outcome-component-field="traitIds"
                          data-outcome-kind="{{outcome.kind}}"
                          data-index="{{component.index}}"
                          title="Свойства Получения HP"
                        >
                          {{selectOptions @root.hpGainSourceTraitChoices selected=component.traitIds}}
                        </multi-select>
                      {{/if}}

                      <button
                        type="button"
                        class="fast-nri-damage-component-remove"
                        data-action="removeOutcomeComponent"
                        data-outcome-kind="{{outcome.kind}}"
                        data-index="{{component.index}}"
                        title="Удалить компонент"
                      >
                        <i class="fa-solid fa-trash"></i>
                      </button>
                    </div>
                  {{/each}}
                </div>

                {{#if outcome.isHpGain}}
                  <small class="fast-nri-help">
                    Это Получение HP. «Исцеление» является свойством источника;
                    «Лечение» — процесс восстановления потерянных обычных HP.
                  </small>
                {{/if}}
              {{/if}}
            </section>
          {{/each}}
        </div>
      </div>
      </div>

      <div class="fast-nri-formation-rules">
        <h3>Модификаторы Строя</h3>
        <div class="fast-nri-three">
          <label>Бонус себе
            <input type="number" min="0" name="system.rules.formation.selfBonus" value="{{system.rules.formation.selfBonus}}" />
          </label>
          <label>Бонус соседним союзникам
            <input type="number" min="0" name="system.rules.formation.adjacentAllyBonus" value="{{system.rules.formation.adjacentAllyBonus}}" />
          </label>
          <label>Штраф Строю цели для владельца
            <input type="number" min="0" name="system.rules.formation.targetPenalty" value="{{system.rules.formation.targetPenalty}}" />
          </label>
        </div>
        <small class="fast-nri-help">
          Машинные модификаторы для расчёта поля. Одинаковые бонусы одного направления не складываются: используется наибольший.
          Штраф цели действует только при расчёте Строя относительно владельца этой способности.
        </small>
      </div>

      <div class="fast-nri-ability-effect-links">
        <h3>Эффекты</h3>
        <small class="fast-nri-help">
          Перетащите сюда Effect Item. При использовании способности он появится
          в chat-card и его можно будет перетащить на токен.
        </small>

        <div
          class="fast-nri-effect-link-dropzone"
          data-fast-nri-effect-link-dropzone
        >
          Перетащите Effect сюда
        </div>

        <div class="fast-nri-linked-effect-list">
          {{#each linkedEffectRows as |effect|}}
            <div class="fast-nri-linked-effect-row">
              <img src="{{effect.img}}" alt="" />
              <div>
                <strong>{{effect.name}}</strong>
                <small>{{effect.durationLabel}}</small>
              </div>
              <button
                type="button"
                data-action="removeLinkedEffect"
                data-effect-uuid="{{effect.uuid}}"
                title="Убрать связь"
              >
                <i class="fa-solid fa-xmark"></i>
              </button>
            </div>
          {{else}}
            <small class="fast-nri-help">Связанных эффектов нет.</small>
          {{/each}}
        </div>
      </div>
    </section>
  {{/if}}

  {{#if isEquipment}}
    <section class="fast-nri-section">
      <h2>Снаряжение</h2>
      <div class="fast-nri-two">
        <label>
          Категория
          <input type="text" name="system.category" value="{{system.category}}" />
        </label>
        <div class="fast-nri-item-equip-config">
          <label class="fast-nri-checkbox-label" title="Активен и учитывается в системных расчётах">
            <input
              type="checkbox"
              data-fast-nri-item-equipped
              {{#if system.equipped}}checked{{/if}}
            />
            Экипирован
          </label>

          {{#if showHeldToggle}}
            <label class="fast-nri-checkbox-label" title="Физически находится в руках">
              <input
                type="checkbox"
                data-fast-nri-item-held
                {{#if system.held}}checked{{/if}}
              />
              В руках
            </label>
          {{/if}}

          <label>
            Требует рук
            <select data-fast-nri-item-hands>
              <option value="0" {{#if (eq system.hands 0)}}selected{{/if}}>Не требует</option>
              <option value="1" {{#if (eq system.hands 1)}}selected{{/if}}>1</option>
              <option value="2" {{#if (eq system.hands 2)}}selected{{/if}}>2</option>
            </select>
          </label>
        </div>
      </div>

      <label class="fast-nri-property-field">
        Свойства
        <multi-select name="system.propertyIds">
          {{selectOptions propertyChoices selected=system.propertyIds}}
        </multi-select>
      </label>
    </section>
  {{/if}}

  {{#if isConsumable}}
    <section class="fast-nri-section">
      <h2>Расходник</h2>
      <label>
        Количество
        <input type="number" name="system.quantity" value="{{system.quantity}}" />
      </label>
    </section>
  {{/if}}

  {{#if isEffect}}
    <section class="fast-nri-section">
      <div class="fast-nri-section-heading">
        <div>
          <h2>Effect</h2>
          <p class="fast-nri-help">
            Пока Effect только отслеживает длительность и стаки. Игровых штрафов,
            бонусов и ограничений он автоматически не применяет.
          </p>
        </div>

        <button type="button" data-action="sendEffectToChat">
          <i class="fa-solid fa-message"></i>
          В чат
        </button>
      </div>

      <div class="fast-nri-two">
        <label>
          Вид
          <select name="system.effectKind">
            {{selectOptions effectKindChoices selected=system.effectKind}}
          </select>
        </label>

        <label>
          Стаки
          <select name="system.stacking.mode">
            {{selectOptions effectStackingChoices selected=system.stacking.mode}}
          </select>
        </label>
      </div>

      <div class="fast-nri-two">
        <label>
          Длительность
          <select name="system.duration.mode">
            {{selectOptions effectDurationChoices selected=system.duration.mode}}
          </select>
        </label>

        {{#if (eq system.duration.mode "rounds")}}
          <label>
            Раундов
            <input
              type="number"
              min="1"
              name="system.duration.rounds"
              value="{{system.duration.rounds}}"
            />
          </label>
        {{/if}}
      </div>

      {{#if (eq system.duration.mode "rounds")}}
        <label>
          Снимать
          <select name="system.duration.expiry">
            {{selectOptions effectExpiryChoices selected=system.duration.expiry}}
          </select>
        </label>
      {{/if}}

      <div class="fast-nri-effect-definition-summary">
        <strong>{{effectDurationLabel}}</strong>
      </div>

      <div class="fast-nri-formation-rules">
        <h3>Модификаторы Строя</h3>
        <div class="fast-nri-three">
          <label>Бонус себе
            <input type="number" min="0" name="system.rules.formation.selfBonus" value="{{system.rules.formation.selfBonus}}" />
          </label>
          <label>Бонус соседним союзникам
            <input type="number" min="0" name="system.rules.formation.adjacentAllyBonus" value="{{system.rules.formation.adjacentAllyBonus}}" />
          </label>
          <label>Штраф Строю цели для владельца
            <input type="number" min="0" name="system.rules.formation.targetPenalty" value="{{system.rules.formation.targetPenalty}}" />
          </label>
        </div>
        <small class="fast-nri-help">Машинные модификаторы действуют только пока этот Effect находится на Actor.</small>
      </div>

      <div class="fast-nri-effect-rule-flags">
        <label class="fast-nri-checkbox-label" title="Только для вычисления состояния поля; кнопки атак не блокируются">
          <input
            type="checkbox"
            name="system.rules.disableMeleeControl"
            {{#if system.rules.disableMeleeControl}}checked{{/if}}
          />
          Отключает контроль ближнего боя
        </label>
        <small>Машинное свойство: пока Effect действует, существо не создаёт контролируемых клеток ближнего боя.</small>
      </div>

      {{#if item.isEmbedded}}
        <div class="fast-nri-effect-runtime-summary">
          <span>Наложено на: <strong>{{item.parent.name}}</strong></span>
          <span>Стаков: <strong>{{effectRuntimeStackCount}}</strong></span>
          <span>{{effectRuntimeDuration}}</span>
          <small>ПКМ по иконке в панели эффектов снимает один стак.</small>
        </div>
      {{/if}}
    </section>
  {{/if}}

  <section class="fast-nri-section">
    <h2>Описание</h2>
    <textarea name="system.description" rows="12">{{system.description}}</textarea>
  </section>
</div>
