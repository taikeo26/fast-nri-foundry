<div class="fast-nri-sheet fast-nri-item" autocomplete="off">
  <header class="fast-nri-header">
    <img class="fast-nri-portrait" src="{{item.img}}" alt="{{item.name}}" />

    <div class="fast-nri-identity">
      <input class="fast-nri-name" type="text" name="name" value="{{item.name}}" />
      <div class="fast-nri-subline">
        <span>{{item.type}}</span>
        {{#unless isEffect}}
          <label>
            Уровень
            <input type="number" name="system.level" value="{{system.level}}" />
          </label>
        {{/unless}}
      </div>
    </div>
  </header>

  {{#if isWeapon}}
    <section class="fast-nri-section">
      <h2>Оружие</h2>
      <div class="fast-nri-two">
        <label>
          Дистанция
          <input type="text" name="system.range" value="{{system.range}}" />
        </label>
        <label>
          Вид атаки 6.3
          <select name="system.attackType">
            <option value="melee" {{#if (eq system.attackType "melee")}}selected{{/if}}>Ближняя атака</option>
            <option value="ranged" {{#if (eq system.attackType "ranged")}}selected{{/if}}>Дистанционная атака</option>
          </select>
        </label>
        <label>
          Тип урона
          <select name="system.damageType">
            <option value="physical" {{#if (eq system.damageType "physical")}}selected{{/if}}>Физический</option>
            <option value="magic" {{#if (eq system.damageType "magic")}}selected{{/if}}>Магический</option>
          </select>
        </label>
      </div>


      <div class="fast-nri-two">
        <label class="fast-nri-property-field">
          Свойства
          <multi-select name="system.propertyIds">
            {{selectOptions propertyChoices selected=system.propertyIds}}
          </multi-select>
        </label>
        <div class="fast-nri-item-equip-config">
          <label class="fast-nri-checkbox-label" title="Активен и учитывается в системных расчётах">
            <input
              type="checkbox"
              data-fast-nri-item-equipped
              {{#if system.equipped}}checked{{/if}}
            />
            Экипирован
          </label>

          {{#if showHeldToggle}}
            <label class="fast-nri-checkbox-label" title="Физически находится в руках">
              <input
                type="checkbox"
                data-fast-nri-item-held
                {{#if system.held}}checked{{/if}}
              />
              В руках
            </label>
          {{/if}}

          <label>
            Требует рук
            <select data-fast-nri-item-hands>
              <option value="0" {{#if (eq system.hands 0)}}selected{{/if}}>Не требует</option>
              <option value="1" {{#if (eq system.hands 1)}}selected{{/if}}>1</option>
              <option value="2" {{#if (eq system.hands 2)}}selected{{/if}}>2</option>
            </select>
          </label>
        </div>
      </div>

      <div class="fast-nri-three">
        <label>Частичный — базовая формула
          <input type="text" name="system.damage.partial" value="{{system.damage.partial}}" />
        </label>
        <label>Успех — базовая формула
          <input type="text" name="system.damage.success" value="{{system.damage.success}}" />
        </label>
        <label>Большой — базовая формула
          <input type="text" name="system.damage.great" value="{{system.damage.great}}" />
        </label>
      </div>

      <div class="fast-nri-damage-composition">
        <div class="fast-nri-damage-composition-heading">
          <h3>Состав урона</h3>
          <small>Если профиль содержит компоненты ниже, они заменяют его базовую формулу.</small>
        </div>

        {{#each damageComponentProfiles as |profile|}}
          <section class="fast-nri-damage-component-profile">
            <div class="fast-nri-damage-component-profile-heading">
              <strong>{{profile.label}}</strong>
              <button
                type="button"
                data-action="addDamageComponent"
                data-profile="{{profile.id}}"
                title="Добавить компонент урона"
              >
                <i class="fa-solid fa-plus"></i>
                Компонент
              </button>
            </div>

            {{#if profile.components.length}}
              <div class="fast-nri-damage-component-list">
                {{#each profile.components as |component|}}
                  <div class="fast-nri-damage-component-row">
                    <input
                      type="text"
                      value="{{component.formula}}"
                      data-fast-nri-damage-component-field="formula"
                      data-profile="{{profile.id}}"
                      data-index="{{component.index}}"
                      title="Формула компонента"
                    />

                    <select
                      data-fast-nri-damage-component-field="damageType"
                      data-profile="{{profile.id}}"
                      data-index="{{component.index}}"
                      title="Тип урона компонента"
                    >
                      <option value="physical" {{#if (eq component.damageType "physical")}}selected{{/if}}>Физический</option>
                      <option value="magic" {{#if (eq component.damageType "magic")}}selected{{/if}}>Магический</option>
                    </select>

                    <multi-select
                      data-fast-nri-damage-component-field="traitIds"
                      data-profile="{{profile.id}}"
                      data-index="{{component.index}}"
                      title="Свойства этого компонента"
                    >
                      {{selectOptions @root.damageTraitChoices selected=component.traitIds}}
                    </multi-select>

                    <button
                      type="button"
                      class="fast-nri-damage-component-remove"
                      data-action="removeDamageComponent"
                      data-profile="{{profile.id}}"
                      data-index="{{component.index}}"
                      title="Удалить компонент"
                    >
                      <i class="fa-solid fa-trash"></i>
                    </button>
                  </div>
                {{/each}}
              </div>
            {{else}}
              <small class="fast-nri-help">Используется базовая формула профиля и общий тип урона оружия.</small>
            {{/if}}
          </section>
        {{/each}}
      </div>
    </section>
  {{/if}}

  {{#if isAbility}}
    <section class="fast-nri-section fast-nri-ability-editor">
      <div class="fast-nri-section-heading">
        <div>
          <h2>{{#if abilityIsSpell}}Заклинание{{else}}Способность{{/if}}</h2>
          <small class="fast-nri-help">Один Item-тип для способностей и заклинаний. Заклинание определяется свойством «Заклинание».</small>
        </div>
      </div>

      <nav class="fast-nri-ability-editor-tabs" aria-label="Разделы способности">
        <button type="button" data-fast-nri-ability-tab="card">Карточка</button>
        <button type="button" data-fast-nri-ability-tab="check">Проверка и цель</button>
        <button type="button" data-fast-nri-ability-tab="profiles">Профили</button>
        <button type="button" data-fast-nri-ability-tab="defense">Защита</button>
        <button type="button" data-fast-nri-ability-tab="extra">Дополнительно</button>
      </nav>

      <div class="fast-nri-ability-editor-pane" data-fast-nri-ability-pane="card">
        <h3>Свойства</h3>
        <label class="fast-nri-property-field">
          Свойства карточки
          <multi-select name="system.traitIds">
            {{selectOptions abilityTraitChoices selected=system.traitIds}}
          </multi-select>
        </label>
        <small class="fast-nri-help">Свойства — структурированные ключевые слова Rulebook. Ближняя/Дистанционная, Область и Вмешательство автоматически попадают в ActionContext.</small>

        <h3>Требуется</h3>
        <div class="fast-nri-four fast-nri-cost-grid">
          <label>Воздействия
            <input type="number" min="0" name="system.costs.action" value="{{system.costs.action}}" />
          </label>
          <label>Движения
            <input type="number" min="0" name="system.costs.movement" value="{{system.costs.movement}}" />
          </label>
          <label>Вмешательства
            <input type="number" min="0" name="system.costs.intervention" value="{{system.costs.intervention}}" />
          </label>
          <label class="fast-nri-checkbox-label">
            <input type="checkbox" name="system.costs.freeAction" {{#if system.costs.freeAction}}checked{{/if}} />
            <span>Свободное действие</span>
          </label>
        </div>
        <div class="fast-nri-two">
          <label>Классовый ресурс · минимум
            <input type="number" min="0" name="system.costs.classResourceMin" value="{{system.costs.classResourceMin}}" />
          </label>
          <label>Классовый ресурс · максимум
            <input type="number" min="0" name="system.costs.classResourceMax" value="{{system.costs.classResourceMax}}" />
          </label>
        </div>
        <small class="fast-nri-help">Базовые ресурсы показываются и предупреждают, но не списываются автоматически. Классовый ресурс списывается мягко с Undo; диапазон позволяет настроить стоимость вроде 1–3.</small>

        <label class="fast-nri-rich-label">Дополнительная стоимость / особое «Требуется»
          <prose-mirror name="system.costs.additionalText" value="{{system.costs.additionalText}}" toggled></prose-mirror>
        </label>

        <h3>Текст карточки</h3>
        <label class="fast-nri-rich-label">Описание / основной эффект
          <prose-mirror name="system.description" value="{{system.description}}" toggled></prose-mirror>
        </label>
        <div class="fast-nri-two fast-nri-rich-grid">
          <label class="fast-nri-rich-label">Условие
            <prose-mirror name="system.conditionText" value="{{system.conditionText}}" toggled></prose-mirror>
          </label>
          <label class="fast-nri-rich-label">Требование
            <prose-mirror name="system.requirementText" value="{{system.requirementText}}" toggled></prose-mirror>
          </label>
          <label class="fast-nri-rich-label">Ограничение
            <prose-mirror name="system.limitationText" value="{{system.limitationText}}" toggled></prose-mirror>
          </label>
          <label class="fast-nri-rich-label">Исключение
            <prose-mirror name="system.exceptionText" value="{{system.exceptionText}}" toggled></prose-mirror>
          </label>
        </div>
      </div>

      <div class="fast-nri-ability-editor-pane" data-fast-nri-ability-pane="check">
        <h3>Цель и дистанция</h3>
        <div class="fast-nri-two">
          <label>Тип цели
            <select name="system.targeting.mode">
              {{selectOptions abilityTargetModeChoices selected=system.targeting.mode}}
            </select>
          </label>
          <label>Отношение
            <select name="system.targeting.relation">
              {{selectOptions abilityTargetRelationChoices selected=system.targeting.relation}}
            </select>
          </label>
          <label>Минимум целей
            <input type="number" min="0" name="system.targeting.countMin" value="{{system.targeting.countMin}}" />
          </label>
          <label>Максимум целей
            <input type="number" min="0" name="system.targeting.countMax" value="{{system.targeting.countMax}}" />
          </label>
        </div>
        <div class="fast-nri-two">
          <label>Дистанция
            <select name="system.targeting.rangeMode">
              {{selectOptions abilityRangeModeChoices selected=system.targeting.rangeMode}}
            </select>
          </label>
          {{#if (eq system.targeting.rangeMode "cells")}}
            <label>Клеток
              <input type="number" min="0" name="system.targeting.rangeCells" value="{{system.targeting.rangeCells}}" />
            </label>
          {{/if}}
          <label class="fast-nri-checkbox-label">
            <input type="checkbox" name="system.targeting.requiresVisibility" {{#if system.targeting.requiresVisibility}}checked{{/if}} />
            <span>Требует видимость</span>
          </label>
        </div>
        <div class="fast-nri-two">
          <label>Форма области
            <select name="system.targeting.areaShape">
              {{selectOptions abilityAreaShapeChoices selected=system.targeting.areaShape}}
            </select>
          </label>
          <label>Размер / запись области
            <input type="text" name="system.targeting.areaSize" value="{{system.targeting.areaSize}}" placeholder="например 3×3 или линия 8" />
          </label>
        </div>
        <label class="fast-nri-rich-label">Частное правило цели / области
          <prose-mirror name="system.targeting.text" value="{{system.targeting.text}}" toggled></prose-mirror>
        </label>

        <div class="fast-nri-ability-attack-config">
          <h3>Проверка</h3>
          <label class="fast-nri-checkbox-label">
            <input type="checkbox" name="system.check.enabled" {{#if system.check.enabled}}checked{{/if}} />
            <span>Есть проверка</span>
          </label>
          {{#if system.check.enabled}}
            <label>Формула проверки
              <input type="text" name="system.check.formula" value="{{system.check.formula}}" placeholder="1d20 + {combatDie}" />
            </label>
            <label>Целевая характеристика
              <select name="system.check.targetCharacteristic">
                <option value="armor" {{#if (eq system.check.targetCharacteristic "armor")}}selected{{/if}}>КЗ</option>
                <option value="awareness" {{#if (eq system.check.targetCharacteristic "awareness")}}selected{{/if}}>Внимательность</option>
                <option value="reflex" {{#if (eq system.check.targetCharacteristic "reflex")}}selected{{/if}}>Рефлекс</option>
                <option value="fortitude" {{#if (eq system.check.targetCharacteristic "fortitude")}}selected{{/if}}>Стойкость</option>
                <option value="will" {{#if (eq system.check.targetCharacteristic "will")}}selected{{/if}}>Воля</option>
              </select>
            </label>
            <label class="fast-nri-checkbox-label">
              <input type="checkbox" name="system.defenseProcedure.directedDefense" {{#if system.defenseProcedure.directedDefense}}checked{{/if}} />
              <span>Для направленной атаки против КЗ доступна Направленная защита</span>
            </label>
            <small class="fast-nri-help">Противодействие и Уворот выводятся общим конструктором из Check + свойств. Специальные защитные Ability выбранного токена добавляются тем же обработчиком кнопки «Защита».</small>
          {{/if}}
        </div>
      </div>

      <div class="fast-nri-ability-editor-pane" data-fast-nri-ability-pane="profiles">
        <h3>Профили результата по степени</h3>
        <small class="fast-nri-help">Профиль может одновременно содержать урон, Лечение, временные HP, rich-text эффект и связанные Effect Item. При Check используется профиль итоговой степени.</small>

        <div class="fast-nri-profile-list">
          {{#each abilityProfiles as |profile|}}
            <section class="fast-nri-result-profile {{#if profile.enabled}}enabled{{/if}}">
              <div class="fast-nri-result-profile-heading">
                <label class="fast-nri-checkbox-label">
                  <input type="checkbox" name="system.profiles.{{profile.degree}}.enabled" {{#if profile.enabled}}checked{{/if}} />
                  <strong>{{profile.label}}</strong>
                </label>
              </div>

              {{#if profile.enabled}}
                <label class="fast-nri-rich-label">Эффект степени
                  <prose-mirror name="system.profiles.{{profile.degree}}.text" value="{{profile.text}}" toggled></prose-mirror>
                </label>

                {{#each profile.channels as |channel|}}
                  <div class="fast-nri-profile-channel">
                    <div class="fast-nri-profile-channel-heading">
                      <label class="fast-nri-checkbox-label">
                        <input type="checkbox" name="system.profiles.{{profile.degree}}.{{channel.kind}}.enabled" {{#if channel.enabled}}checked{{/if}} />
                        <span>{{channel.label}}</span>
                      </label>
                      {{#if channel.enabled}}
                        <button type="button" data-action="addProfileComponent" data-degree="{{profile.degree}}" data-outcome-kind="{{channel.kind}}">
                          <i class="fa-solid fa-plus"></i> Компонент
                        </button>
                      {{/if}}
                    </div>

                    {{#if channel.enabled}}
                      {{#if channel.isDamage}}
                        <div class="fast-nri-three fast-nri-profile-damage-transform">
                          <label>Удалить наибольших
                            <input type="number" min="0" name="system.profiles.{{profile.degree}}.damage.removeHighest" value="{{channel.removeHighest}}" />
                          </label>
                          <label>Удалить наименьших
                            <input type="number" min="0" name="system.profiles.{{profile.degree}}.damage.removeLowest" value="{{channel.removeLowest}}" />
                          </label>
                          <label class="fast-nri-checkbox-label">
                            <input type="checkbox" name="system.profiles.{{profile.degree}}.damage.removeAll" {{#if channel.removeAll}}checked{{/if}} />
                            <span>Удалить весь урон</span>
                          </label>
                        </div>
                        <small class="fast-nri-help">Удаление применяется к уже выпавшим частям урона. Так настраиваются профили областей вроде «убрать самый маленький / самый большой».</small>
                      {{/if}}
                      <div class="fast-nri-outcome-component-list">
                        {{#each channel.components as |component|}}
                          <div class="fast-nri-outcome-component-row {{#if channel.isDamage}}is-damage{{else}}is-hp-gain{{/if}}">
                            <input type="text" value="{{component.formula}}" data-fast-nri-profile-component-field="formula" data-degree="{{profile.degree}}" data-outcome-kind="{{channel.kind}}" data-index="{{component.index}}" title="Формула" />
                            {{#if channel.isDamage}}
                              <select data-fast-nri-profile-component-field="damageType" data-degree="{{profile.degree}}" data-outcome-kind="{{channel.kind}}" data-index="{{component.index}}">
                                <option value="physical" {{#if (eq component.damageType "physical")}}selected{{/if}}>Физический</option>
                                <option value="magic" {{#if (eq component.damageType "magic")}}selected{{/if}}>Магический</option>
                              </select>
                              <multi-select data-fast-nri-profile-component-field="traitIds" data-degree="{{profile.degree}}" data-outcome-kind="{{channel.kind}}" data-index="{{component.index}}">
                                {{selectOptions @root.damageTraitChoices selected=component.traitIds}}
                              </multi-select>
                            {{else}}
                              <multi-select data-fast-nri-profile-component-field="traitIds" data-degree="{{profile.degree}}" data-outcome-kind="{{channel.kind}}" data-index="{{component.index}}">
                                {{selectOptions @root.hpGainSourceTraitChoices selected=component.traitIds}}
                              </multi-select>
                            {{/if}}
                            <button type="button" class="fast-nri-damage-component-remove" data-action="removeProfileComponent" data-degree="{{profile.degree}}" data-outcome-kind="{{channel.kind}}" data-index="{{component.index}}" title="Удалить компонент">
                              <i class="fa-solid fa-trash"></i>
                            </button>
                          </div>
                        {{else}}
                          <small class="fast-nri-help">Компонентов нет. Добавьте компонент.</small>
                        {{/each}}
                      </div>
                    {{/if}}
                  </div>
                {{/each}}

                <div class="fast-nri-profile-effect-zone">
                  <strong>Effect Item этой степени</strong>
                  <div class="fast-nri-effect-link-dropzone" data-fast-nri-profile-effect-dropzone data-degree="{{profile.degree}}">Перетащите Effect сюда</div>
                  <div class="fast-nri-linked-effect-list">
                    {{#each profile.effects as |effect|}}
                      <div class="fast-nri-linked-effect-row">
                        <img src="{{effect.img}}" alt="" />
                        <div><strong>{{effect.name}}</strong><small>{{effect.durationLabel}}</small></div>
                        <button type="button" data-action="removeProfileEffect" data-degree="{{profile.degree}}" data-effect-uuid="{{effect.uuid}}"><i class="fa-solid fa-xmark"></i></button>
                      </div>
                    {{/each}}
                  </div>
                </div>
              {{/if}}
            </section>
          {{/each}}
        </div>
      </div>

      <div class="fast-nri-ability-editor-pane" data-fast-nri-ability-pane="defense">
        <div class="fast-nri-ability-defense-config">
          <h3>Защитное действие</h3>
          <label class="fast-nri-checkbox-label">
            <input type="checkbox" name="system.defenseAction.enabled" {{#if system.defenseAction.enabled}}checked{{/if}} />
            <span>Предлагать эту Ability обработчиком кнопки «Защита»</span>
          </label>
          <small class="fast-nri-help">Источник вариантов — Ability Item выбранного токена-защитника. Стандартные и специальные Защиты показываются вместе.</small>

          {{#if system.defenseAction.enabled}}
            <div class="fast-nri-two">
              <label>Процедура защиты
                <select name="system.defenseAction.procedure">{{selectOptions defenseProcedureChoices selected=system.defenseAction.procedure}}</select>
              </label>
              <label>Кого можно защищать
                <select name="system.defenseAction.targetScope">{{selectOptions defenseTargetScopeChoices selected=system.defenseAction.targetScope}}</select>
              </label>
              <label>Вмешательств
                <input type="number" min="0" name="system.defenseAction.interventionCost" value="{{system.defenseAction.interventionCost}}" />
              </label>
              <label>Дистанция
                <select name="system.defenseAction.rangeMode">{{selectOptions defenseRangeModeChoices selected=system.defenseAction.rangeMode}}</select>
              </label>
            </div>
            {{#if (eq system.defenseAction.rangeMode "cells")}}
              <label>Клеток
                <input type="number" min="0" name="system.defenseAction.rangeCells" value="{{system.defenseAction.rangeCells}}" />
              </label>
            {{/if}}
            <div class="fast-nri-two">
              <label>Перемещение
                <select name="system.defenseAction.movementMode">{{selectOptions defenseMovementModeChoices selected=system.defenseAction.movementMode}}</select>
              </label>
              <label>Какие части удалять
                <select name="system.defenseAction.damageSelectionMode">{{selectOptions defenseDamageSelectionChoices selected=system.defenseAction.damageSelectionMode}}</select>
              </label>
              <label>Кубы Боевой подготовки
                <input type="text" name="system.defenseAction.combatDiceFormula" value="{{system.defenseAction.combatDiceFormula}}" placeholder="пусто = обычная формула Actor" />
              </label>
              <label>Удалить частей урона
                <input type="number" min="0" name="system.defenseAction.removeDamageParts" value="{{system.defenseAction.removeDamageParts}}" />
              </label>
              <label>Снижение степени Эффекта
                <input type="number" min="0" name="system.defenseAction.effectDegreeReduction" value="{{system.defenseAction.effectDegreeReduction}}" />
              </label>
              <label>Характеристика Самозащиты
                <select name="system.defenseAction.selfDefenseCharacteristic">
                  <option value="" {{#unless system.defenseAction.selfDefenseCharacteristic}}selected{{/unless}}>По общему правилу</option>
                  <option value="fortitude" {{#if (eq system.defenseAction.selfDefenseCharacteristic "fortitude")}}selected{{/if}}>Стойкость</option>
                  <option value="reflex" {{#if (eq system.defenseAction.selfDefenseCharacteristic "reflex")}}selected{{/if}}>Рефлекс</option>
                  <option value="will" {{#if (eq system.defenseAction.selfDefenseCharacteristic "will")}}selected{{/if}}>Воля</option>
                  <option value="awareness" {{#if (eq system.defenseAction.selfDefenseCharacteristic "awareness")}}selected{{/if}}>Внимательность</option>
                </select>
              </label>
            </div>
            <div class="fast-nri-two">
              <label class="fast-nri-checkbox-label"><input type="checkbox" name="system.defenseAction.requiresVisibility" {{#if system.defenseAction.requiresVisibility}}checked{{/if}} /><span>Требует видимость</span></label>
              <label class="fast-nri-checkbox-label"><input type="checkbox" name="system.defenseAction.allowManeuver" {{#if system.defenseAction.allowManeuver}}checked{{/if}} /><span>Разрешает защиту от Манёвра</span></label>
            </div>
          {{/if}}
        </div>

        <div class="fast-nri-ability-defense-config">
          <h3>Модификатор Защитных действий</h3>
          <label class="fast-nri-checkbox-label"><input type="checkbox" name="system.defenseModifier.enabled" {{#if system.defenseModifier.enabled}}checked{{/if}} /><span>Эта способность меняет формулу Защитных действий</span></label>
          {{#if system.defenseModifier.enabled}}
            <div class="fast-nri-two">
              <label>Область действия
                <select name="system.defenseModifier.scope">{{selectOptions defenseModifierScopeChoices selected=system.defenseModifier.scope}}</select>
              </label>
              <label>Кубы Боевой подготовки
                <input type="text" name="system.defenseModifier.combatDiceFormula" value="{{system.defenseModifier.combatDiceFormula}}" />
              </label>
            </div>
          {{/if}}
        </div>
      </div>

      <div class="fast-nri-ability-editor-pane" data-fast-nri-ability-pane="extra">
        <div class="fast-nri-ability-outcome-config">
          <h3>Результаты без профиля степени</h3>
          <small class="fast-nri-help">Совместимый канал для действий без Check и старых Item. Для Check-способностей предпочтительны профили по степени.</small>
          <div class="fast-nri-outcome-channel-list">
            {{#each outcomeChannels as |outcome|}}
              <section class="fast-nri-outcome-channel {{#if outcome.enabled}}enabled{{/if}}">
                <div class="fast-nri-outcome-channel-heading">
                  <label class="fast-nri-checkbox-label">
                    <input type="checkbox" data-fast-nri-outcome-enabled data-outcome-kind="{{outcome.kind}}" {{#if outcome.enabled}}checked{{/if}} />
                    <i class="fa-solid {{outcome.icon}}"></i><strong>{{outcome.label}}</strong>
                  </label>
                  {{#if outcome.enabled}}<button type="button" data-action="addOutcomeComponent" data-outcome-kind="{{outcome.kind}}"><i class="fa-solid fa-plus"></i> Компонент</button>{{/if}}
                </div>
                {{#if outcome.enabled}}
                  <div class="fast-nri-outcome-component-list">
                    {{#each outcome.components as |component|}}
                      <div class="fast-nri-outcome-component-row {{#if outcome.isDamage}}is-damage{{else}}is-hp-gain{{/if}}">
                        <input type="text" value="{{component.formula}}" data-fast-nri-outcome-component-field="formula" data-outcome-kind="{{outcome.kind}}" data-index="{{component.index}}" />
                        {{#if outcome.isDamage}}
                          <select data-fast-nri-outcome-component-field="damageType" data-outcome-kind="{{outcome.kind}}" data-index="{{component.index}}"><option value="physical" {{#if (eq component.damageType "physical")}}selected{{/if}}>Физический</option><option value="magic" {{#if (eq component.damageType "magic")}}selected{{/if}}>Магический</option></select>
                          <multi-select data-fast-nri-outcome-component-field="traitIds" data-outcome-kind="{{outcome.kind}}" data-index="{{component.index}}">{{selectOptions @root.damageTraitChoices selected=component.traitIds}}</multi-select>
                        {{else}}
                          <multi-select data-fast-nri-outcome-component-field="traitIds" data-outcome-kind="{{outcome.kind}}" data-index="{{component.index}}">{{selectOptions @root.hpGainSourceTraitChoices selected=component.traitIds}}</multi-select>
                        {{/if}}
                        <button type="button" class="fast-nri-damage-component-remove" data-action="removeOutcomeComponent" data-outcome-kind="{{outcome.kind}}" data-index="{{component.index}}"><i class="fa-solid fa-trash"></i></button>
                      </div>
                    {{/each}}
                  </div>
                {{/if}}
              </section>
            {{/each}}
          </div>
        </div>

        <div class="fast-nri-formation-rules">
          <h3>Модификаторы Строя</h3>
          <div class="fast-nri-three">
            <label>Бонус себе<input type="number" min="0" name="system.rules.formation.selfBonus" value="{{system.rules.formation.selfBonus}}" /></label>
            <label>Бонус соседним союзникам<input type="number" min="0" name="system.rules.formation.adjacentAllyBonus" value="{{system.rules.formation.adjacentAllyBonus}}" /></label>
            <label>Штраф Строю цели<input type="number" min="0" name="system.rules.formation.targetPenalty" value="{{system.rules.formation.targetPenalty}}" /></label>
          </div>
        </div>

        <div class="fast-nri-ability-effect-links">
          <h3>Эффекты без привязки к степени</h3>
          <small class="fast-nri-help">Такие Effect Item всегда показываются в исходной chat-card способности. Для условного эффекта привяжите Effect к конкретной степени в «Профилях».</small>
          <div class="fast-nri-effect-link-dropzone" data-fast-nri-effect-link-dropzone>Перетащите Effect сюда</div>
          <div class="fast-nri-linked-effect-list">
            {{#each linkedEffectRows as |effect|}}
              <div class="fast-nri-linked-effect-row">
                <img src="{{effect.img}}" alt="" /><div><strong>{{effect.name}}</strong><small>{{effect.durationLabel}}</small></div>
                <button type="button" data-action="removeLinkedEffect" data-effect-uuid="{{effect.uuid}}"><i class="fa-solid fa-xmark"></i></button>
              </div>
            {{else}}<small class="fast-nri-help">Связанных эффектов нет.</small>{{/each}}
          </div>
        </div>
      </div>
    </section>
  {{/if}}

  {{#if isEquipment}}
    <section class="fast-nri-section">
      <h2>Снаряжение</h2>
      <div class="fast-nri-two">
        <label>
          Категория
          <input type="text" name="system.category" value="{{system.category}}" />
        </label>
        <div class="fast-nri-item-equip-config">
          <label class="fast-nri-checkbox-label" title="Активен и учитывается в системных расчётах">
            <input
              type="checkbox"
              data-fast-nri-item-equipped
              {{#if system.equipped}}checked{{/if}}
            />
            Экипирован
          </label>

          {{#if showHeldToggle}}
            <label class="fast-nri-checkbox-label" title="Физически находится в руках">
              <input
                type="checkbox"
                data-fast-nri-item-held
                {{#if system.held}}checked{{/if}}
              />
              В руках
            </label>
          {{/if}}

          <label>
            Требует рук
            <select data-fast-nri-item-hands>
              <option value="0" {{#if (eq system.hands 0)}}selected{{/if}}>Не требует</option>
              <option value="1" {{#if (eq system.hands 1)}}selected{{/if}}>1</option>
              <option value="2" {{#if (eq system.hands 2)}}selected{{/if}}>2</option>
            </select>
          </label>
        </div>
      </div>

      <label class="fast-nri-property-field">
        Свойства
        <multi-select name="system.propertyIds">
          {{selectOptions propertyChoices selected=system.propertyIds}}
        </multi-select>
      </label>
    </section>
  {{/if}}

  {{#if isConsumable}}
    <section class="fast-nri-section">
      <h2>Расходник</h2>
      <label>
        Количество
        <input type="number" name="system.quantity" value="{{system.quantity}}" />
      </label>
    </section>
  {{/if}}

  {{#if isEffect}}
    <section class="fast-nri-section">
      <div class="fast-nri-section-heading">
        <div>
          <h2>Effect</h2>
          <p class="fast-nri-help">
            Пока Effect только отслеживает длительность и стаки. Игровых штрафов,
            бонусов и ограничений он автоматически не применяет.
          </p>
        </div>

        <button type="button" data-action="sendEffectToChat">
          <i class="fa-solid fa-message"></i>
          В чат
        </button>
      </div>

      <div class="fast-nri-two">
        <label>
          Вид
          <select name="system.effectKind">
            {{selectOptions effectKindChoices selected=system.effectKind}}
          </select>
        </label>

        <label>
          Стаки
          <select name="system.stacking.mode">
            {{selectOptions effectStackingChoices selected=system.stacking.mode}}
          </select>
        </label>
      </div>

      <div class="fast-nri-two">
        <label>
          Длительность
          <select name="system.duration.mode">
            {{selectOptions effectDurationChoices selected=system.duration.mode}}
          </select>
        </label>

        {{#if (eq system.duration.mode "rounds")}}
          <label>
            Раундов
            <input
              type="number"
              min="1"
              name="system.duration.rounds"
              value="{{system.duration.rounds}}"
            />
          </label>
        {{/if}}
      </div>

      {{#if (eq system.duration.mode "rounds")}}
        <label>
          Снимать
          <select name="system.duration.expiry">
            {{selectOptions effectExpiryChoices selected=system.duration.expiry}}
          </select>
        </label>
      {{/if}}

      <div class="fast-nri-effect-definition-summary">
        <strong>{{effectDurationLabel}}</strong>
      </div>

      <div class="fast-nri-formation-rules">
        <h3>Модификаторы Строя</h3>
        <div class="fast-nri-three">
          <label>Бонус себе
            <input type="number" min="0" name="system.rules.formation.selfBonus" value="{{system.rules.formation.selfBonus}}" />
          </label>
          <label>Бонус соседним союзникам
            <input type="number" min="0" name="system.rules.formation.adjacentAllyBonus" value="{{system.rules.formation.adjacentAllyBonus}}" />
          </label>
          <label>Штраф Строю цели для владельца
            <input type="number" min="0" name="system.rules.formation.targetPenalty" value="{{system.rules.formation.targetPenalty}}" />
          </label>
        </div>
        <small class="fast-nri-help">Машинные модификаторы действуют только пока этот Effect находится на Actor.</small>
      </div>

      <div class="fast-nri-effect-rule-flags">
        <label class="fast-nri-checkbox-label" title="Только для вычисления состояния поля; кнопки атак не блокируются">
          <input
            type="checkbox"
            name="system.rules.disableMeleeControl"
            {{#if system.rules.disableMeleeControl}}checked{{/if}}
          />
          Отключает контроль ближнего боя
        </label>
        <small>Машинное свойство: пока Effect действует, существо не создаёт контролируемых клеток ближнего боя.</small>
      </div>

      {{#if item.isEmbedded}}
        <div class="fast-nri-effect-runtime-summary">
          <span>Наложено на: <strong>{{item.parent.name}}</strong></span>
          <span>Стаков: <strong>{{effectRuntimeStackCount}}</strong></span>
          <span>{{effectRuntimeDuration}}</span>
          <small>ПКМ по иконке в панели эффектов снимает один стак.</small>
        </div>
      {{/if}}
    </section>
  {{/if}}

  {{#unless isAbility}}
    <section class="fast-nri-section">
      <h2>Описание</h2>
      <prose-mirror name="system.description" value="{{system.description}}" toggled></prose-mirror>
    </section>
  {{/unless}}
</div>
