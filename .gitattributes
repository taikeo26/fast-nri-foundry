# Keep repository text files on LF on every platform.
* text=auto eol=lf

# Binary assets must never undergo line-ending conversion.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.svg binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.zip binary

# Foundry compendium databases (NeDB source and migrated LevelDB files).
packs/** binary
